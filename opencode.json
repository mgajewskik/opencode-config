{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "instructions": [
    "AGENTS.md"
  ],
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-terra",
  "provider": {
    "openai": {
      "options": {
        "timeout": 900000
      }
    }
  },
  "agent": {
    "smart": {
      "prompt": "{file:./agents/smart.md}"
    },
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "formatter": {
    "terraform": {
      "disabled": false,
      "command": [
        "terraform",
        "fmt",
        "$FILE"
      ],
      "extensions": [
        ".tf",
        ".hcl",
        ".tfvars"
      ]
    },
    "shfmt": {
      "disabled": false,
      "command": [
        "shfmt",
        "-w",
        "$FILE"
      ],
      "extensions": [
        ".sh",
        ".bash",
        ".zsh",
        ".ksh"
      ]
    },
    "prettier": {
      "disabled": false,
      "command": [
        "mise",
        "x",
        "npm:prettier",
        "--",
        "prettier",
        "--write",
        "--tab-width",
        "2",
        "$FILE"
      ],
      "extensions": [
        ".json"
      ]
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "codebase-memory-mcp",
        "--ui=true",
        "--port=9749"
      ]
    }
  },
  "tools": {
    "honcho_peer_context": false,
    "honcho_peer_card": false,
    "honcho_summaries": false,
    "honcho_upload_file": false,
    "openmemory": false,
    "codebase-memory-mcp_query_graph": false,
    "codebase-memory-mcp_index_repository": false,
    "codebase-memory-mcp_delete_project": false,
    "codebase-memory-mcp_detect_changes": false,
    "codebase-memory-mcp_manage_adr": false,
    "codebase-memory-mcp_ingest_traces": false
  },
  "permission": {
    "edit": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/**": "allow",
      "~/.config/opencode/skills": "allow",
      "~/.config/opencode/skills/**": "allow"
    },
    "bash": {
      "*": "allow",
      "git push": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",
      "git clean -df*": "deny",
      "sudo*": "deny",
      "doas*": "deny",
      "pkexec*": "deny",
      "su *": "deny",
      "runuser*": "deny",
      "rm -rf /*": "deny",
      "rm -rf /": "deny",
      "rm -rf ~*": "deny",
      "rm -rf $HOME*": "deny",
      "mkfs*": "deny",
      "dd if=* of=/dev/*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "halt*": "deny",
      "poweroff*": "deny",
      "curl * | sh*": "deny",
      "curl * | bash*": "deny",
      "wget * | sh*": "deny",
      "wget * | bash*": "deny"
    }
  }
}
