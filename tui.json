{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "opencode",
  "keybinds": {
    "leader": "ctrl+x",
    "model_list": "ctrl+m",
    "editor_open": "ctrl+e",
    "session_new": "ctrl+n",
    "session_list": "ctrl+s",
    "session_parent": "ctrl+k",
    "session_child_cycle": "ctrl+l",
    "session_child_cycle_reverse": "ctrl+h",
    "messages_page_up": "none",
    "messages_page_down": "none",
    "messages_half_page_up": "ctrl+u",
    "messages_half_page_down": "ctrl+d"
  }
}
